; Harbour Jump, the Godot sample from the Ludo.ai rotoscoping video (ours, written by Claude Code).
; Art loads at run time from res://art and res://ref, timing and travel data from res://data.
config_version=5

[application]
config/name="Harbour Jump (rotoscoping)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=768
window/size/viewport_height=1344
window/size/window_width_override=576
window/size/window_height_override=1008
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.03, 0.05, 0.12, 1)
